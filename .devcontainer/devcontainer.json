{
  "name": "Agent_Crew (private, on demand)",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "node",
  "forwardPorts": [4317],
  "portsAttributes": {
    "4317": { "label": "Agent_Crew · keep private", "onAutoForward": "silent", "requireLocalPort": true }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "remoteEnv": {
    "PORT": "4317",
    "AGENT_CREW_DATA": "${containerWorkspaceFolder}/data",
    "AGENT_CREW_PROVIDER": "mock"
  },
  "postCreateCommand": "npm ci --ignore-scripts --no-audit",
  "shutdownAction": "stopContainer"
}
