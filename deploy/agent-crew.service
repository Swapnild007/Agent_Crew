[Unit]
Description=Agent_Crew private owner workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-crew
Group=agent-crew
WorkingDirectory=/opt/agent-crew
StateDirectory=agent-crew
StateDirectoryMode=0700
EnvironmentFile=/etc/agent-crew/agent-crew.env
ExecStartPre=/usr/bin/env node /opt/agent-crew/deploy/check-remote.mjs
ExecStart=/usr/bin/env node /opt/agent-crew/server.mjs
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
